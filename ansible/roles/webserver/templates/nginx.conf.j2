# ansible/roles/webserver/templates/nginx.conf.j2

server {
    listen 80;
    server_name _;

    # Serve the static status page frontend
    root  /var/www/statuspage;
    index index.html;

    # All /api/* requests proxy through to the Node.js app server
    location /api/ {
        proxy_pass         http://10.0.1.53:3000;
        proxy_http_version 1.1;
        proxy_set_header   Host            $host;
        proxy_set_header   X-Real-IP       $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;

        # Surface upstream errors clearly (useful while learning)
        proxy_intercept_errors off;
    }

    # Static files — served directly by Nginx, fast
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Health check endpoint — Nginx answers this itself, no upstream needed
    location /health {
        return 200 'web-ok\n';
        add_header Content-Type text/plain;
    }
}
